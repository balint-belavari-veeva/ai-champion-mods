{
  "description": "Cache Keeper hooks module + Vault tracking hook",
  "modules": [
    "./register.mjs"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/bin/vault-track.py\""
          }
        ]
      }
    ]
  }
}
